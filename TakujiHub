local function createToggleRow(fieldName, labelText)
    local row = Instance.new("Frame")
    row.Name = fieldName .. "_Row"
    row.Size = UDim2.new(1, 0, 0, 26)
    row.BackgroundTransparency = 1
    row.Parent = frame

    local label = Instance.new("TextLabel")
    label.Name = "Label"
    label.Size = UDim2.new(1, -90, 1, 0)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.Gotham
    label.TextSize = 14
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextColor3 = Color3.fromRGB(210, 220, 250)
    label.Text = labelText
    label.Parent = row

    local button = Instance.new("TextButton")
    button.Name = "ToggleButton"
    button.AnchorPoint = Vector2.new(1, 0.5)
    button.Position = UDim2.new(1, -4, 0.5, 0)
    button.Size = UDim2.new(0, 70, 0, 22)
    button.BackgroundColor3 = Color3.fromRGB(40, 48, 70)
    button.BorderSizePixel = 0
    button.Font = Enum.Font.GothamBold
    button.TextSize = 13
    button.TextColor3 = Color3.fromRGB(220, 230, 255)
    button.Parent = row

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = button

    local function applyState()
        local value = Water[fieldName]
        if value then
            button.Text = "ON"
            button.BackgroundColor3 = Color3.fromRGB(50, 190, 120)
        else
            button.Text = "OFF"
            button.BackgroundColor3 = Color3.fromRGB(120, 40, 50)
        end
    end

    applyState()

    button.MouseButton1Click:Connect(function()
        Water[fieldName] = not Water[fieldName]
        applyState()
    end)
end

